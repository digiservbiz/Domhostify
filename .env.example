# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_NAME=DomHostify API

# Optional affiliate destinations. Use approved HTTPS URLs only; keep partner credentials private.
# AFFILIATE_URL_EXAMPLEHOST=https://approved-partner.example/offer
# AFFILIATE_URL_EXAMPLECLOUD=https://approved-partner.example/business

# Comma-separated browser origins allowed to call the API. Set exact HTTPS origins in production.
# CORS_ALLOWED_ORIGINS=https://domhostify.example,https://www.domhostify.example
# Local development defaults are used when this variable is unset.

# Optional SQLAlchemy connection string; defaults to local SQLite.
# DATABASE_URL=sqlite:///./domhostify.db

# Bootstrap-only marketplace credentials for local testing.
# Use distinct, high-entropy values; do not share the seller token across sellers.
# These are not a replacement for production user accounts, sessions, or roles.
# DOMHOSTIFY_SELLER_API_TOKEN=replace-with-a-long-random-secret
# DOMHOSTIFY_ADMIN_API_TOKEN=replace-with-a-different-long-random-secret
